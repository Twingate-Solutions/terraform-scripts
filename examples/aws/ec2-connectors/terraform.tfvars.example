# examples/ec2/terraform.tfvars.example
# Copy this file to terraform.tfvars and update with your values

# =============================================================================
# GENERAL CONFIGURATION
# =============================================================================

environment = "production"
vpc_id      = "vpc-12345678"

common_tags = {
  Project     = "twingate-connector"
  Environment = "production"
  Owner       = "platform-team"
  CostCenter  = "infrastructure"
}

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

additional_cidr_blocks = [
  "172.16.0.0/12",    # Additional RFC1918 space
  "192.168.0.0/16",   # Additional RFC1918 space
  "10.100.0.0/16"     # On-premises network
]

ssh_cidr_blocks = [
  "10.0.0.0/8"        # Internal network only
]

public_ssh_cidr_blocks = [
  "203.0.113.0/24"    # Your office IP range - be specific!
]

# =============================================================================
# EC2 CONFIGURATION
# =============================================================================

ec2_key_pair_name          = "twingate-connector-key"
enable_ssh_access          = true
enable_ssm                 = true
enable_detailed_monitoring = true

# Private Connector
ec2_instance_type    = "t3.small"
ec2_min_size         = 1
ec2_max_size         = 3
ec2_desired_capacity = 2

# Public Connector (Optional)
create_public_connector     = false
ec2_public_instance_type    = "t3.micro"
use_elastic_ip              = true

# High Availability Connector (Optional)
create_ha_connector        = false
ec2_ha_instance_type       = "t3.medium"
ec2_ha_min_size            = 2
ec2_ha_max_size            = 6
ec2_ha_desired_capacity    = 3

# =============================================================================
# EBS CONFIGURATION
# =============================================================================

root_volume_size     = 20
root_volume_size_ha  = 30
root_volume_type     = "gp3"
encrypt_root_volume  = true

# =============================================================================
# TWINGATE CONFIGURATION
# =============================================================================
twingate_log_level        = "3" # 3 = info, 7 = debug
twingate_log_analytics    = true # required for enabling log output

# Intentionally NOT real tokens. These are placeholders, use secrets instead.
twingate_url = "https://mycompany.twingate.com"
twingate_access_token  = "your-access-token-here"
twingate_refresh_token = "your-refresh-token-here"