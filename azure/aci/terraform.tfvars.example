# Copy to terraform.tfvars (gitignored) and fill in. Only tg_network is required.
# Prefer `export TWINGATE_API_TOKEN=...` over setting tg_api_token here.

# General
app_name        = "tg-tf-demo"
app_environment = "demo"

# Azure
azure_subscription_id       = null # null = ARM_SUBSCRIPTION_ID, then the az CLI default subscription
azure_location              = "eastus"
azure_vnet_cidr_block       = "10.44.0.0/16"
azure_aci_connector_cpu     = 1
azure_aci_connector_memory  = 2
azure_aci_registry_username = null # Docker Hub username, avoids anonymous pull rate limits
azure_aci_registry_password = null # Docker Hub password or PAT; prefer TF_VAR_azure_aci_registry_password
azure_dns_zone_name         = "tg-tf-demo.int"

# Twingate
tg_network            = "<tenant>" # <tenant>.twingate.com
tg_connector_count    = 2
tg_connector_image    = "twingate/connector:1"
tg_users              = [] # ["VXNlcjoxMjM0NQ=="] from <tenant>.twingate.com/users/<id>
tg_existing_group_ids = [] # ["R3JvdXA6MTIzNDU="]

tg_security_policy_name   = null  # existing policy name, or null for the Default Policy
tg_autolock_duration      = "30d" # null disables the auto-lock access policy
tg_create_service_account = false

tg_log_analytics_version = "v2"
tg_log_level             = "3" # 7 = debug
